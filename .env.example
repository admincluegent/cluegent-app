# Cluegent environment template
# Copy this file to .env for local development only.
# Never commit real API keys, Firebase service accounts, Razorpay secrets, or webhook secrets.

################################################################################
# Desktop app / renderer configuration
################################################################################

# Firebase web app config used by the Electron renderer.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_DATABASE_ID=cluegent

# Optional app metadata.
VITE_APP_VERSION=1.0.0

################################################################################
# Firebase Functions secrets
################################################################################
# Set these with:
# firebase functions:secrets:set SECRET_NAME
#
# Do not place production values in this file.

# LLM providers
DEEPSEEK_AI_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Realtime STT provider
ASSEMBLY_AI_API_KEY=your_assemblyai_api_key_here

# Razorpay test-mode billing
RAZORPAY_TEST_KEY_ID=your_razorpay_test_key_id_here
RAZORPAY_TEST_KEY_SECRET=your_razorpay_test_key_secret_here
RAZORPAY_TEST_WEBHOOK_SECRET=your_razorpay_test_webhook_secret_here
RAZORPAY_TEST_ALLOWED_EMAILS=owner@example.com,tester@example.com
RAZORPAY_TEST_PLAN_PRO_MONTHLY=plan_xxx_pro_monthly
RAZORPAY_TEST_PLAN_PRO_YEARLY=plan_xxx_pro_yearly
RAZORPAY_TEST_PLAN_POWER_MONTHLY=plan_xxx_power_monthly
RAZORPAY_TEST_PLAN_POWER_YEARLY=plan_xxx_power_yearly

################################################################################
# Firebase Admin local development
################################################################################

# Optional for local emulator/admin scripts only.
# Keep the JSON file outside the repo or use an ignored local path.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/to/service-account.json
