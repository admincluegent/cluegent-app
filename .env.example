# Cluegent environment template
# Copy this file to .env for local development only.
# Never commit real API keys, Firebase service accounts, Razorpay secrets, or webhook secrets.
#
# Notes:
# - VITE_* values are bundled into the desktop renderer and are not private secrets.
# - Backend provider keys and Razorpay secrets must be set in Firebase Secret Manager
#   before deployed functions can use them.
# - Keep real values only in your local .env or Firebase secrets, never in Git.

################################################################################
# Desktop app / renderer configuration
################################################################################

# Firebase web app config used by the Electron renderer.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_DATABASE_ID=cluegent

# Optional app metadata.
VITE_APP_VERSION=1.0.0

################################################################################
# Desktop app / Electron local development overrides
################################################################################

# Optional: override Firebase Functions URLs when testing against another project,
# emulator, or staging backend. Leave blank to use the app defaults.
FIREBASE_FUNCTIONS_BASE_URL=https://us-central1-your-project-id.cloudfunctions.net
FIREBASE_PROCESS_ASSISTANT_REPLY_STREAM_ENDPOINT=
FIREBASE_ASSEMBLY_TOKEN_ENDPOINT=
FIREBASE_DEEPGRAM_TOKEN_ENDPOINT=
FIREBASE_STT_USAGE_ENDPOINT=

# Optional: direct desktop fallback keys for local-only model testing.
# Production quota-enforced responses should go through Firebase Functions.
GOOGLE_API_KEY=your_google_or_gemini_api_key_here

# Optional: Google Calendar integration local development.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Optional: local Ollama testing.
USE_OLLAMA=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

################################################################################
# Firebase Functions secrets
################################################################################
# Set these with:
# firebase functions:secrets:set SECRET_NAME
#
# Do not place production values in this file.

# LLM providers
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_AI_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Realtime STT provider
ASSEMBLY_AI_API_KEY=your_assemblyai_api_key_here

# Razorpay test-mode billing.
# Test subscriptions are still available for test/staging flows.
#
# Keep Power yearly hidden/blocked while Razorpay's per-transaction limit is
# below the Power yearly amount. Set both flags to true after approval.
VITE_POWER_YEARLY_ENABLED=false
POWER_YEARLY_ENABLED=false

RAZORPAY_TEST_KEY_ID=your_razorpay_test_key_id_here
RAZORPAY_TEST_KEY_SECRET=your_razorpay_test_key_secret_here
RAZORPAY_TEST_WEBHOOK_SECRET=your_razorpay_test_webhook_secret_here
RAZORPAY_TEST_ALLOWED_EMAILS=owner@example.com,tester@example.com
RAZORPAY_TEST_PLAN_PRO_MONTHLY=plan_xxx_pro_monthly
RAZORPAY_TEST_PLAN_PRO_YEARLY=plan_xxx_pro_yearly
RAZORPAY_TEST_PLAN_POWER_MONTHLY=plan_xxx_power_monthly
RAZORPAY_TEST_PLAN_POWER_YEARLY=plan_xxx_power_yearly

# Razorpay live one-time order billing.
# Current live Pro/Power INR/USD prices are stored in backend code; Razorpay only
# needs live API keys and the live webhook secret.
RAZORPAY_LIVE_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_LIVE_KEY_SECRET=your_razorpay_live_key_secret_here
RAZORPAY_LIVE_WEBHOOK_SECRET=your_razorpay_live_webhook_secret_here

################################################################################
# Firebase Admin local development
################################################################################

# Optional for local emulator/admin scripts only.
# Keep the JSON file outside the repo or use an ignored local path.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/to/service-account.json
