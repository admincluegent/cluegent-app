{
  "firestore": [
    {
      "database": "cluegent",
      "rules": "firestore.rules"
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        ".env",
        ".env.*",
        "*.pem",
        "*.key",
        "*service-account*.json",
        "*firebase-admin*.json",
        "*google-application-credentials*.json"
      ]
    }
  ],
  "hosting": {
    "public": "website",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/how-to-use.html",
        "destination": "/how-to-use-cluegent/",
        "type": 301
      },
      {
        "source": "/alternatives/chiku-ai{,/**}",
        "destination": "/chiku-ai-alternative/",
        "type": 301
      },
      {
        "source": "/blog/cluegent-vs-chiku-ai{,/**}",
        "destination": "/chiku-ai-alternative/",
        "type": 301
      },
      {
        "source": "/alternatives/parakeet-ai{,/**}",
        "destination": "/parakeet-ai-alternative/",
        "type": 301
      },
      {
        "source": "/blog/cluegent-vs-parakeet-ai{,/**}",
        "destination": "/parakeet-ai-alternative/",
        "type": 301
      },
      {
        "source": "/blog/parakeet-ai-alternative{,/**}",
        "destination": "/parakeet-ai-alternative/",
        "type": 301
      },
      {
        "source": "/parakeet-ai-free-alternative{,/**}",
        "destination": "/parakeet-ai-alternative/",
        "type": 301
      },
      {
        "source": "/parakeet-ai-free-trial-alternative{,/**}",
        "destination": "/parakeet-ai-alternative/",
        "type": 301
      },
      {
        "source": "/blog/parakeet-ai-review-is-it-worth-it{,/**}",
        "destination": "/blog/parakeet-ai/",
        "type": 301
      },
      {
        "source": "/blog/parakeet-ai-review{,/**}",
        "destination": "/blog/parakeet-ai/",
        "type": 301
      },
      {
        "source": "/blog/parakeet-ai-review-reddit{,/**}",
        "destination": "/blog/parakeet-ai/",
        "type": 301
      },
      {
        "source": "/blog/parakeet-ai-reddit{,/**}",
        "destination": "/blog/parakeet-ai/",
        "type": 301
      },
      {
        "source": "/blog/parakeet-ai-interview{,/**}",
        "destination": "/blog/parakeet-ai/",
        "type": 301
      },
      {
        "source": "/blog/parakeet-ai-download{,/**}",
        "destination": "/blog/parakeet-ai/",
        "type": 301
      },
      {
        "source": "/parakeet-ai-review{,/**}",
        "destination": "/blog/parakeet-ai/",
        "type": 301
      },
      {
        "source": "/blog/parakeet-ai-free{,/**}",
        "destination": "/blog/parakeet-ai-pricing/",
        "type": 301
      },
      {
        "source": "/blog/parakeet-ai-is-free-or-not{,/**}",
        "destination": "/blog/parakeet-ai-pricing/",
        "type": 301
      },
      {
        "source": "/parakeet-ai-pricing-alternative{,/**}",
        "destination": "/blog/parakeet-ai-pricing/",
        "type": 301
      },
      {
        "source": "/parakeet-ai-pricing-india{,/**}",
        "destination": "/blog/parakeet-ai-pricing/",
        "type": 301
      },
      {
        "source": "/alternatives/lockedin-ai{,/**}",
        "destination": "/lockedin-ai-alternative/",
        "type": 301
      },
      {
        "source": "/blog/cluegent-vs-lockedin-ai{,/**}",
        "destination": "/lockedin-ai-alternative/",
        "type": 301
      },
      {
        "source": "/alternatives/final-round-ai{,/**}",
        "destination": "/blog/cluegent-vs-final-round-ai/",
        "type": 301
      },
      {
        "source": "/final-round-ai-alternative{,/**}",
        "destination": "/blog/cluegent-vs-final-round-ai/",
        "type": 301
      },
      {
        "source": "/blog/ai-interview-assistant-for-freshers{,/**}",
        "destination": "/ai-interview-assistant-for-freshers/",
        "type": 301
      },
      {
        "source": "/blog/best-ai-interview-assistant-for-google-meet{,/**}",
        "destination": "/ai-interview-assistant-for-google-meet/",
        "type": 301
      },
      {
        "source": "/blog/best-ai-interview-assistant-for-zoom{,/**}",
        "destination": "/ai-interview-assistant-for-zoom/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png|svg|webp|avif|gif|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "**/*.@(mp4|webm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
