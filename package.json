{
  "name": "cluegent",
  "version": "1.0.8",
  "main": "dist-electron/electron/main.js",
  "description": "Cluegent is an AI copilot that helps with live conversation, screen context, and meeting assistance.",
  "scripts": {
    "clean": "rimraf dist dist-electron",
    "dev": "vite",
    "build": "npm run clean && tsc && vite build",
    "build:electron": "node scripts/build-electron.js",
    "build:electron:tsc": "tsc -p electron/tsconfig.json",
    "typecheck:electron": "tsc -p electron/tsconfig.json --noEmit",
    "preview": "vite preview",
    "postinstall": "cross-env SHARP_IGNORE_GLOBAL_LIBVIPS=1 npm rebuild sharp && node scripts/patch-electron-plist.js",
    "electron:dev": "npm run build:electron && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://127.0.0.1:5180 electron .",
    "electron:build": "npm run build:electron && cross-env NODE_ENV=production electron .",
    "app:dev": "concurrently \"npm run dev -- --host 127.0.0.1 --port 5180 --strictPort\" \"wait-on http://127.0.0.1:5180 && npm run electron:dev\"",
    "app:build": "npm run build && npm run build:electron && cross-env NATIVELY_BUILD_ALL_MAC_ARCHES=1 npm run build:native && electron-builder",
    "app:build:store": "npm run build && npm run build:electron && npm run build:native && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win appx --x64",
    "watch": "tsc -p electron/tsconfig.json --watch",
    "start": "npm run app:dev",
    "dist": "npm run app:build",
    "build:native": "node scripts/build-native.js",
    "seo:generate": "node scripts/generate-seo-site.mjs"
  },
  "build": {
    "generateUpdatesFilesForAllChannels": true,
    "appId": "com.cluegent.desktop",
    "afterPack": "./scripts/ad-hoc-sign.js",
    "afterSign": "./scripts/notarize-mac.js",
    "productName": "Cluegent",
    "files": [
      "dist",
      "dist-electron",
      "native-module",
      "package.json",
      "node_modules",
      "!**/native-module/target",
      "!**/native-module/src",
      "!**/native-module/.cargo"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.dylib"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      },
      {
        "from": "assets/icon.icns",
        "to": "icon.icns"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "identity": "Prithivi Raj (N527762S68)",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Cluegent needs Screen Recording permission to capture system audio for meeting transcription.",
        "NSMicrophoneUsageDescription": "Cluegent needs microphone access to transcribe your voice during meetings."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/win/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/png/",
      "category": "Office"
    },
    "appx": {
      "identityName": "PrithiviRaj.Cluegent",
      "publisher": "CN=55E259BD-3714-4A3C-9E96-08C741D7BEE8",
      "publisherDisplayName": "PrithiviRaj",
      "displayName": "Cluegent",
      "applicationId": "PrithiviRaj.Cluegent",
      "backgroundColor": "#111111",
      "languages": [
        "en-US"
      ],
      "capabilities": [
        "runFullTrust",
        "internetClient",
        "microphone"
      ],
      "artifactName": "${productName}-Store-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icons/win/icon.ico",
      "uninstallerIcon": "assets/icons/win/icon.ico",
      "installerHeaderIcon": "assets/icons/win/icon.ico",
      "shortcutName": "Cluegent",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "admincluegent",
        "repo": "cluegent-app",
        "releaseType": "release"
      }
    ]
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.0.4",
    "@napi-rs/cli": "^3.5.1",
    "@playwright/test": "^1.59.1",
    "@types/color": "^4.2.0",
    "@types/electron": "^1.4.38",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "dotenv": "^17.3.1",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "esbuild": "^0.28.1",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@bany/curl-to-json": "^1.2.10",
    "@google/genai": "^1.52.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.2",
    "axios": "^1.7.7",
    "electron-updater": "^6.8.9",
    "firebase": "^12.15.0",
    "form-data": "^4.0.6",
    "framer-motion": "^12.29.2",
    "jspdf": "^4.0.0",
    "katex": "^0.16.27",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.11.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-query": "^3.39.3",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.33.5",
    "uuid": "^11.0.3",
    "ws": "^8.21.0"
  },
  "overrides": {
    "dompurify": "^3.4.11",
    "js-yaml": "^5.1.0",
    "joi": "^18.2.3",
    "tar": "^7.5.16",
    "protobufjs": "^7.6.4"
  }
}
